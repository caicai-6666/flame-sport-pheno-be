# Python 缓存
__pycache__/
*.py[cod]

# 虚拟环境
.venv/
venv/

# 本地环境变量
.env

# 测试文件
tests/
test_*.py
*_test.py
test_*.http
*_test.http

# 本地实验与临时文件
/experiment/
/tmp/

# 运行期资源文件
# 实际图片等资源由 assets/.gitignore 控制，不提交到 Git。
assets/**
!assets/
!assets/.gitignore
!assets/.gitkeep
!assets/images/
!assets/images/.gitkeep

# 本地脚本
/scripts/
