# 应用基础配置
PROJECT_NAME=flame-sport-pheno-be
# production：钉钉企业内部 H5 免登；development：auth_code 直接匹配本地 user.id。
APP_MODE=production

# 数据库配置
DATABASE_URL=mysql+asyncmy://用户名:密码@127.0.0.1:3307/flame_sport_pheno?charset=utf8mb4
DB_ECHO=false

# 登录会话缓存，单位：秒
AUTH_CACHE_TTL_SECONDS=7200
AUTH_CACHE_CLEANUP_INTERVAL_SECONDS=300

# 赛季业务配置。开始日前允许抢先参与，开始日后仅在指定天数内允许报名。
SEASON_PARTICIPATION_ALLOWED_DAYS=7

# 钉钉企业内部 H5 微应用凭证。development 模式下可留空。
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
# 钉钉请求超时、token 预热间隔和提前刷新窗口，单位：秒
DINGTALK_HTTP_TIMEOUT_SECONDS=5
DINGTALK_ACCESS_TOKEN_REFRESH_INTERVAL_SECONDS=300
DINGTALK_ACCESS_TOKEN_REFRESH_SKEW_SECONDS=300

# DeepSeek 文本初审与手动评测共用配置。不要提交真实 API Key。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_HTTP_TIMEOUT_SECONDS=60

# DeepSeek 定时文本初审。默认关闭；时间单位：秒。
LLM_PRELIMINARY_REVIEW_ENABLED=false
LLM_PRELIMINARY_REVIEW_INTERVAL_SECONDS=900
LLM_PRELIMINARY_REVIEW_MIN_AGE_SECONDS=300

# 排行榜快照刷新。时间单位：秒。
LEADERBOARD_REFRESH_ENABLED=true
LEADERBOARD_REFRESH_ON_STARTUP=true
LEADERBOARD_REFRESH_INTERVAL_SECONDS=900

# 图片接口的浏览器私有缓存时长，单位：秒。
IMAGE_CACHE_MAX_AGE_SECONDS=604800
