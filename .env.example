PROJECT_NAME=flame-sport-pheno-be
DATABASE_URL=mysql+asyncmy://用户名:密码@主机:端口/数据库名?charset=utf8mb4
DB_ECHO=false

AUTH_CACHE_TTL_SECONDS=7200
AUTH_CACHE_CLEANUP_INTERVAL_SECONDS=300
# 赛季允许参与时间
SEASON_PARTICIPATION_ALLOWED_DAYS=7

# 钉钉企业内部 H5 微应用凭证。请仅在本地 .env 或部署环境中填写真实值。
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=

# 单位：秒。应用会定时预热 token，并在登录请求时临近过期自动刷新。
DINGTALK_HTTP_TIMEOUT_SECONDS=5
DINGTALK_ACCESS_TOKEN_REFRESH_INTERVAL_SECONDS=300
DINGTALK_ACCESS_TOKEN_REFRESH_SKEW_SECONDS=300

# DeepSeek 文本运动评测实验。仅 tests/test_llm_sport_evaluation.py 使用，禁止提交真实 API Key。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-chat 将于 2026-07-24 停止维护，默认使用当前兼容模型。
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_HTTP_TIMEOUT_SECONDS=60

# 每日 DeepSeek 文本初审。默认关闭；时间使用 IANA 时区的 HH:MM 本地时间。
LLM_PRELIMINARY_REVIEW_ENABLED=false
LLM_PRELIMINARY_REVIEW_DAILY_TIME=02:00
LLM_PRELIMINARY_REVIEW_TIMEZONE=Asia/Shanghai

# 排行榜快照刷新配置
LEADERBOARD_REFRESH_ENABLED=true
LEADERBOARD_REFRESH_ON_STARTUP=true
LEADERBOARD_REFRESH_INTERVAL_SECONDS=86400
